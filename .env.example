# Скопировать в .env и заполнить. .env в .gitignore — не коммитить, токены и пароли никому не показывать.
# Подробно — docs/HARNESS.md, раздел «Новая машина».

# --- GitHub: доска «Подбор параметров DAMP» ---
# Адрес доски.
GITHUB_URL=https://github.com/users/qwertukg/projects/1/views/1
# Токен доски — классический (Settings → Developer settings → Tokens (classic)), ТОЛЬКО область project, без repo:
# у него не должно быть доступа к коду. Токен с точными правами доску личного аккаунта не видит.
GITHUB_TOKEN=
# Токен задач — с точными правами (Fine-grained): Repository access — только qwertukg/DAMP; Permissions — Issues:
# Read and write, Contents: No access. Им пишутся комментарии, заголовки и тексты задач-карточек, создаются задачи.
GITHUB_ISSUES_TOKEN=

# --- GLM 5.3: сервер с моделью (vLLM на 127.0.0.1:8893 сервера, 2 потока) ---
# Агент сам поднимает SSH-туннель на 127.0.0.1:18893 (tools/glm/agent.py).
GML_SSH_HOST=admin@<адрес сервера>
PASS_SSH_PASS=

# --- Эта машина ---
# Python проекта (venv с зависимостями DAMP: numpy, torch, numba, …).
DAMP_PYTHON=D:/Projects/DAMP/.venv/Scripts/python.exe
# Папка стенда; по умолчанию tools/tuning/stand в репозитории.
# DAMP_STAND=

# Выкладывать карты прогонов в ветку board-maps репозитория (картинки в комментариях доски); нужна запись в репозиторий у GITHUB_TOKEN
DAMP_MAPS_UPLOAD=1
